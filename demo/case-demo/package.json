{
  "name": "case-demo",
  "version": "1.0.0",
  "description": "测试用例生成 agent — 蒸馏自 aibox CaseGenerateAgent。读需求文档 → 套用游戏测试用例方法论 → 产出层级化 Markdown 用例树 → 导出 .xmind。HTTP REST + MCP (stdio & Streamable HTTP) + 交互式 CLI。",
  "scripts": {
    "build": "tsc --noEmit",
    "bundle": "node build.mjs",
    "dev": "tsx src/serve.ts",
    "start": "tsx src/serve.ts",
    "serve": "tsx src/serve.ts",
    "serve:headless": "tsx src/serve.ts --no-interactive",
    "mcp": "tsx src/mcp.ts",
    "http": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
