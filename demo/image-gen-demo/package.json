{
  "name": "image-gen-demo",
  "version": "2.0.0",
  "description": "Standalone image-generation agent — HTTP REST + MCP (stdio & Streamable HTTP) + interactive CLI. Built on ekko-agent runtime.",
  "bin": {
    "image-gen-demo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx src/serve.ts",
