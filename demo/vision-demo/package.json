{
  "name": "vision-demo",
  "version": "1.0.0",
  "description": "图像识别分析 agent — HTTP REST + MCP (stdio & Streamable HTTP) + interactive CLI. 支持图像分析/对比/OCR/描述，带思考过程。",
  "scripts": {
    "build": "tsc --noEmit",
    "bundle": "node build.mjs",
    "dev": "tsx src/serve.ts",
    "start": "tsx src/serve.ts",
    "serve": "tsx src/serve.ts",
    "serve:headless": "tsx src/serve.ts --no-interactive",
    "mcp": "tsx src/mcp.ts",
    "http": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
